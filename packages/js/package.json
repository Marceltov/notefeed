{
  "name": "notefeed",
  "version": "0.8.0",
  "description": "Client and CLI for notefeed, a self-hosted inbox for markdown notes that you read back as RSS.",
  "license": "Apache-2.0",
  "author": "Marcel Bruckner",
  "keywords": [
    "notefeed",
    "notes",
    "markdown",
    "rss",
    "self-hosted",
    "homelab",
    "cli"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "notefeed": "dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "test": "tsc && vitest run",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Marceltov/notefeed.git",
    "directory": "packages/js"
  },
  "homepage": "https://docs.notefeed.me/clients/",
  "bugs": {
    "url": "https://github.com/Marceltov/notefeed/issues"
  },
  "devDependencies": {
    "@types/node": "^20",
    "typescript": "^5.9",
    "vitest": "^4.1"
  }
}
