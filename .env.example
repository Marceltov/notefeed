# Required. A long random secret, e.g. `openssl rand -hex 32`.
NOTEFEED_TOKEN=change-me

# Absolute URL readers use to reach notefeed. Leave unset to derive it from the request.
# PUBLIC_URL=https://notes.example.com

# Feed title.
# NOTEFEED_TITLE=notefeed

# Time zone for times shown in the UI.
# TZ=UTC
